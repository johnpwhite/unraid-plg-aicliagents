diff -ruN pa/ci/runners/live-agents-report.sh pb/ci/runners/live-agents-report.sh
--- pa/ci/runners/live-agents-report.sh	1970-01-01 10:00:00.000000000 +1000
+++ pb/ci/runners/live-agents-report.sh	2026-09-24 09:30:18.013572600 +1000
@@ -0,0 +1,58 @@
+#!/usr/bin/env bash
+# Runs INSIDE the Unit-Test Container (aicli-ci/php). Signs the result of a
+# `ci/run live-agents` run (the plugin's tests/live/agent_lifecycle.sh) as
+# /work/.ci-artifacts/live-agents.json — schema aicli-live-agents/1.
+#
+# The Storefront release requires a green artifact no older than 7 days for the
+# EXACT plugin version it releases (ci/scripts/factory/live-agents-verify.php,
+# called from ci/storefront step ⓪b).
+#
+# Inputs (env, provided by ci/run stage_live_agents):
+#   LIVE_PLUGIN   plugin short name (e.g. aicliagents)
+#   LIVE_COMMIT   git HEAD sha of the plugin repo on the dev box (informational)
+#   LIVE_SERVER   test-server host the suite ran on
+# Input (file):  /work/.ci/artifacts/live-agents-run.json (the suite's --json)
+# Input (stdin): the HMAC key (hex) — piped, never argv/env on the .4 host.
+#
+# Signature: HMAC-SHA256 over the SAME canonical JSON as the release gate
+# (lg_gateCanonicalJson in ci/scripts/factory/lib-gate.php, `hmac` excluded).
+#
+# Exit: 0 = artifact written and green; 1 = artifact written but red (a FAIL,
+#       a dry run, or not the full registry); 2 = setup error.
+set -uo pipefail
+
+LIVE_KEY="$(cat || true)"
+[ -n "$LIVE_KEY" ] || { echo "live-agents-report: empty HMAC key on stdin" >&2; exit 2; }
+RUN=/work/.ci/artifacts/live-agents-run.json
+[ -s "$RUN" ] || { echo "live-agents-report: $RUN missing — the suite did not write its summary" >&2; exit 2; }
+export LIVE_KEY
+
+php -d display_errors=stderr -r '
+require "/work/.ci/scripts/factory/lib-gate.php";
+$run = json_decode((string)file_get_contents("/work/.ci/artifacts/live-agents-run.json"), true);
+if (!is_array($run) || ($run["\$schema"] ?? "") !== "aicli-live-agents-run/1") { fwrite(STDERR, "live-agents-report: run summary is not aicli-live-agents-run/1\n"); exit(2); }
+$t = (array)($run["totals"] ?? []);
+$green = ($run["status"] ?? "") === "pass" && empty($run["dry_run"]) && !empty($run["full_registry"])
+    && (int)($t["fail"] ?? 1) === 0 && ($run["plugin_version"] ?? "") !== "";
+$doc = [
+    "\$schema"       => "aicli-live-agents/1",
+    "plugin"         => (string)getenv("LIVE_PLUGIN"),
+    "plugin_version" => (string)($run["plugin_version"] ?? ""),
+    "commit"         => (string)getenv("LIVE_COMMIT"),
+    "server"         => (string)getenv("LIVE_SERVER"),
+    "host"           => (string)($run["host"] ?? ""),
+    "generated_at"   => gmdate("Y-m-d\TH:i:s\Z"),
+    "run_started_at" => (string)($run["started_at"] ?? ""),
+    "full_registry"  => !empty($run["full_registry"]),
+    "agents"         => array_map(static fn($a) => (string)($a["status"] ?? "skip"), (array)($run["agents"] ?? [])),
+    "in_use"         => (array)($run["in_use"] ?? []),
+    "totals"         => $t,
+    "status"         => $green ? "pass" : "fail",
+];
+$doc["hmac"] = hash_hmac("sha256", lg_gateCanonicalJson($doc), trim((string)getenv("LIVE_KEY")));
+@mkdir("/work/.ci-artifacts", 0775, true);
+file_put_contents("/work/.ci-artifacts/live-agents.json", json_encode($doc, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");
+printf("live-agents artifact: %s · v%s · %d agent(s) · pass %d · fail %d · skip %d (in use: %d agent(s))\n",
+    $doc["status"], $doc["plugin_version"], count($doc["agents"]), $t["pass"] ?? 0, $t["fail"] ?? 0, $t["skip"] ?? 0, count($doc["in_use"]));
+exit($green ? 0 : 1);
+'
diff -ruN pa/ci/scripts/factory/live-agents-verify.php pb/ci/scripts/factory/live-agents-verify.php
--- pa/ci/scripts/factory/live-agents-verify.php	1970-01-01 10:00:00.000000000 +1000
+++ pb/ci/scripts/factory/live-agents-verify.php	2026-09-24 09:30:33.471295413 +1000
@@ -0,0 +1,72 @@
+<?php
+/**
+ * live-agents-verify.php — verify a signed live-agents artifact before a
+ * Storefront (public) release. Runs in the aicli-ci/php container via ci/php
+ * (ci/storefront step ⓪b); the HMAC key arrives on stdin.
+ *
+ *   ci/php ci/scripts/factory/live-agents-verify.php \
+ *       --file=/work/unraid-plg-<name>/.ci-artifacts/live-agents.json \
+ *       --plugin=<name> --version=<YYYY.MM.DD.XX> [--max-age-days=7] < gate.key
+ *
+ * Green means: schema aicli-live-agents/1 · HMAC valid (same canonical JSON as
+ * the release gate) · same plugin · the run tested THIS plugin version on the
+ * test server · generated within --max-age-days · the whole registry ran · no
+ * agent failed. Agents skipped because a person was using them are NOT a
+ * failure: they are printed as a `live-agents-warn:` line for the operator.
+ *
+ * Output lines: `live-agents-ok: …`, `live-agents-warn: …`, `live-agents-fail: …`.
+ * Exit: 0 green (warnings allowed) · 1 fail · 2 usage.
+ */
+declare(strict_types=1);
+require __DIR__ . '/lib-gate.php';
+
+$o = getopt('', ['file:', 'plugin:', 'version:', 'max-age-days::']);
+$file = (string)($o['file'] ?? '');
+$plugin = (string)($o['plugin'] ?? '');
+$version = (string)($o['version'] ?? '');
+$maxDays = (int)($o['max-age-days'] ?? 7);
+if ($file === '' || $plugin === '' || $version === '' || $maxDays < 1) {
+    fwrite(STDERR, "usage: live-agents-verify.php --file=PATH --plugin=NAME --version=X [--max-age-days=7] < key\n");
+    exit(2);
+}
+$fail = static function (string $why): void { echo "live-agents-fail: $why\n"; exit(1); };
+
+$key = trim((string)stream_get_contents(STDIN));
+if ($key === '') $fail('no HMAC key on stdin (fails closed)');
+if (!is_file($file)) $fail("missing — no live-agents.json at $file; run `ci/run live-agents --plugin=$plugin` after the Factory publish");
+$doc = json_decode((string)file_get_contents($file), true);
+if (!is_array($doc)) $fail('not valid JSON');
+if (($doc['$schema'] ?? '') !== 'aicli-live-agents/1') $fail('unexpected $schema "' . ($doc['$schema'] ?? '<missing>') . '"');
+foreach (['plugin', 'plugin_version', 'generated_at', 'agents', 'totals', 'status', 'hmac'] as $k) {
+    if (!array_key_exists($k, $doc)) $fail("missing field '$k'");
+}
+$copy = $doc; unset($copy['hmac']);
+if (!hash_equals(hash_hmac('sha256', lg_gateCanonicalJson($copy), $key), strtolower((string)$doc['hmac']))) {
+    $fail('badsig — HMAC mismatch (edited after signing, or the gate key changed)');
+}
+if ($doc['plugin'] !== $plugin) $fail("artifact is for plugin '{$doc['plugin']}', releasing '$plugin'");
+if ((string)$doc['plugin_version'] !== $version) {
+    $fail("the live run tested v{$doc['plugin_version']}, releasing v$version — deploy v$version to the test server and re-run `ci/run live-agents --plugin=$plugin`");
+}
+$ts = strtotime((string)$doc['generated_at']);
+if ($ts === false) $fail('generated_at is not a timestamp');
+$age = time() - $ts;
+if ($age < 0 || $age > $maxDays * 86400) {
+    $fail(sprintf('stale — generated %s (%.1f days ago, limit %d days)', $doc['generated_at'], $age / 86400, $maxDays));
+}
+if (empty($doc['full_registry'])) $fail('the run covered only a subset of agents (--agents); the release needs the whole registry');
+$t = (array)$doc['totals'];
+if ($doc['status'] !== 'pass' || (int)($t['fail'] ?? 1) !== 0) {
+    $bad = array_keys(array_filter((array)$doc['agents'], static fn($s) => $s === 'fail'));
+    $fail('red — ' . (int)($t['fail'] ?? 0) . ' failed step(s)' . ($bad ? ' in: ' . implode(', ', $bad) : ''));
+}
+$inUse = (array)($doc['in_use'] ?? []);
+if ($inUse !== []) {
+    $parts = [];
+    foreach ($inUse as $agent => $who) $parts[] = "$agent (in use by $who)";
+    echo 'live-agents-warn: ' . count($inUse) . ' agent(s) not re-tested because they were in use: ' . implode('; ', $parts) . "\n";
+}
+printf("live-agents-ok: v%s · %d agent(s) · pass %d · skip %d (%d in use) · %s (%.1f days old)\n",
+    $version, count((array)$doc['agents']), (int)($t['pass'] ?? 0), (int)($t['skip'] ?? 0),
+    (int)($t['skip_in_use'] ?? 0), $doc['generated_at'], $age / 86400);
+exit(0);
