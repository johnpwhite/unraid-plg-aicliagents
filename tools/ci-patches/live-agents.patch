+# installs, changes version, survives a remount and starts a workspace on a
+# machine that already has it — the 2026-09-24 "[Agent Binary Missing]" class.
+# `ci/run live-agents` signs <plugin>/.ci-artifacts/live-agents.json; this gate
+# requires it green, for THIS plugin version, the full registry, <= 7 days old.
+# Agents that were in use during the run are listed as a warning only.
+LIVE_MAX_AGE_DAYS="${LIVE_AGENTS_MAX_AGE_DAYS:-7}"
+if [ -f "$PDIR/tests/live/agent_lifecycle.sh" ]; then
+  sect "⓪b LIVE-AGENTS GATE — live-agents.json green · v$VER · full registry · <= ${LIVE_MAX_AGE_DAYS} days"
+  live_fail=""
+  LIVE_FILE="$PDIR/.ci-artifacts/live-agents.json"
+  if [ ! -f "$LIVE_FILE" ]; then
+    live_fail="live-agents-fail: missing — run \`ci/run live-agents --plugin=$PLUGIN\` after the Factory publish"
+  elif [ ! -f "$GATE_KEY_FILE" ]; then
+    live_fail="live-agents-fail: no HMAC key at $GATE_KEY_FILE (fails closed)"
+  else
+    LIVE_OUT="$("$CI_DIR/php" "$FACTORY/live-agents-verify.php" \
+      --file="/work/unraid-plg-$PLUGIN/.ci-artifacts/live-agents.json" --plugin="$PLUGIN" --version="$VER" \
+      --max-age-days="$LIVE_MAX_AGE_DAYS" < "$GATE_KEY_FILE")"
+    LIVE_RC=$?
+    printf '%s\n' "$LIVE_OUT" | sed 's/^/  /'
+    printf '%s\n' "$LIVE_OUT" | grep '^live-agents-warn:' | while IFS= read -r l; do warn "${l#live-agents-warn: }"; done
+    if [ "$LIVE_RC" -ne 0 ]; then
+      live_fail="$(printf '%s\n' "$LIVE_OUT" | grep '^live-agents-fail:' | head -1)"
+      [ -n "$live_fail" ] || live_fail="live-agents-fail: verifier exited $LIVE_RC with no reason line"
+    fi
+  fi
+  if [ -n "$live_fail" ]; then
+    if [ "$PUSH" -eq 1 ] && [ "$FORCE" -ne 1 ]; then
+      err "LIVE-AGENTS GATE FAILED: $live_fail"
+      err "Fix: ci/run live-agents --plugin=$PLUGIN   (on the released version, then re-run)"
+      err "Or, with EXPLICIT user consent after reporting the reason above: ci/storefront --plugin=$PLUGIN --push --force"
+      exit 57
+    elif [ "$PUSH" -eq 1 ]; then
+      warn "LIVE-AGENTS GATE FAILED: $live_fail"
+      warn "--force set — proceeding anyway. This must have been an explicit, informed user decision."
+    else
+      warn "LIVE-AGENTS GATE would FAIL a real push: $live_fail"
+    fi
+  else
+    ok "live-agents verified — every registry agent re-tested on v$VER within ${LIVE_MAX_AGE_DAYS} days"
+  fi
+fi
+
