+# live-agents — the LIVE agent lifecycle suite, run ON .4 against the deployed
+# plugin, then signed (same HMAC key + canonical JSON as the release gate) into
+# <plugin>/.ci-artifacts/live-agents.json. Agents a person is using are SKIPPED
+# ("in use"), never failed; the artifact lists them and ci/storefront warns.
+stage_live_agents() {
+  sect "LIVE-AGENTS ($PLUGIN) — real install · version change · remount · workspace start, every agent"
+  if [ "$HAS_LIVE" -ne 1 ]; then log "no tests/live/agent_lifecycle.sh — live-agents skipped"; return; fi
+  ci_host_guard "$SERVER" rssh "live agent lifecycle suite (installs agents) on $PLUGIN"
+  local run_rc=0 dry=0
+  case " $LIVE_ARGS " in *" --dry-run "*) dry=1 ;; esac
+  [ -n "$LIVE_ARGS" ] && log "suite flags: $LIVE_ARGS"
+  # shellcheck disable=SC2086  # LIVE_ARGS is a validated, space-separated flag list
+  rssh "rm -f $ARTIFACTS/live-agents-run.json; bash $VOL/tests/live/agent_lifecycle.sh --json=$ARTIFACTS/live-agents-run.json $LIVE_ARGS" || run_rc=$?
+  if [ "$dry" -eq 1 ]; then
+    [ "$run_rc" -eq 0 ] && ok "live-agents dry run (plan printed, nothing signed)" || fail "live-agents dry run"
+    return
+  fi
+  [ "$run_rc" -eq 37 ] && { fail "live-agents (host guard refused)"; return; }
+  ensure_php_image
+  ensure_gate_key
+  local commit sign_rc=0
+  commit="$(git -C "$PDIR" rev-parse HEAD 2>/dev/null || echo unknown)"
+  rssh "docker run --rm -i -v $VOL:/work -w /work \
+    -e LIVE_PLUGIN=$PLUGIN -e LIVE_COMMIT=$commit -e LIVE_SERVER=$SERVER \
+    $PHP_IMAGE bash /work/.ci/runners/live-agents-report.sh" < "$GATE_KEY_FILE" || sign_rc=$?
+  mkdir -p "$PDIR/.ci-artifacts"
+  if copy_from_runner "$VOL/.ci-artifacts/live-agents.json" "$PDIR/.ci-artifacts/live-agents.json"; then
+    ok "live-agents artifact → $(basename "$PDIR")/.ci-artifacts/live-agents.json"
+  else
+    fail "live-agents (artifact fetch)"; return
+  fi
+  if [ "$run_rc" -eq 0 ] && [ "$sign_rc" -eq 0 ]; then ok "live-agents GREEN (signed)"
+  else fail "live-agents RED (suite exit $run_rc, report exit $sign_rc — artifact written, blocks ci/storefront --push)"; fi
