Menu="Utilities"
Title="AI CLI Agents"
Icon="assets/icons/google-gemini.png"
---
<?php
/**
 * <module_context>
 * Description: Primary Management page for AICliAgents plugin settings and marketplace.
 * Dependencies: AICliAgentsManager.php, ManagerStyles, ManagerLayout, ManagerConfigTab, ManagerStoreTab, ManagerScripts.
 * </module_context>
 */
require_once '/usr/local/emhttp/plugins/unraid-aicliagents/src/includes/AICliAgentsManager.php';
aicli_ensure_init(true);

$config = getAICliConfig();
$registry = getAICliAgentsRegistry();
$version = \AICliAgents\Services\ConfigService::getVersion();
// Cache-buster for the tray: a session-safe overlay deploy replaces the file
// WITHOUT bumping the plugin version, so a version-only ?v= serves the stale
// cached tray here while the AICliAgents tab (which busts on mtime) shows the
// new one. mtime changes on every copy.
$tray_ver = (string) (@filemtime("/usr/local/emhttp/plugins/unraid-aicliagents/assets/ui/activity-tray.js") ?: 0);
if ($tray_ver === "0") { $tray_ver = $version; }
// AGENT_VOICE.md: same reasoning as the tray — voice.js can change without a
// version bump, so it busts cache on its own mtime, not the plugin version.
$voice_ver = (string) (@filemtime("/usr/local/emhttp/plugins/unraid-aicliagents/assets/ui/voice.js") ?: 0);
if ($voice_ver === "0") { $voice_ver = $version; }
$var = @parse_ini_file("/var/local/emhttp/var.ini");
$csrf_token = $var['csrf_token'] ?? '';
$users = getUnraidUsers();

// Include UI Components
$ui_path = '/usr/local/emhttp/plugins/unraid-aicliagents/src/includes/ui';
require_once "$ui_path/ManagerStyles.php";
require_once "$ui_path/CommonLogging.php";
?>

<link type="text/css" rel="stylesheet" href="<?autov('/webGui/styles/jquery.filetree.css')?>">
<script src="<?autov('/webGui/javascript/jquery.filetree.js')?>"></script>

<?php
require_once "$ui_path/ManagerLayout.php";
require_once "$ui_path/ManagerConfigTab.php";
require_once "$ui_path/ManagerStoreTab.php";
require_once "$ui_path/ManagerStorageTab.php";
require_once "$ui_path/ManagerHubTab.php";
require_once "$ui_path/ManagerRelayTab.php";
require_once "$ui_path/ManagerLogTab.php";
require_once "$ui_path/ManagerGlobalState.php";
require_once "$ui_path/ManagerLogScripts.php";
require_once "$ui_path/ManagerStorageScripts.php";
require_once "$ui_path/ManagerStoreScripts.php";
require_once "$ui_path/ManagerHubScripts.php";
require_once "$ui_path/ManagerRelayScripts.php";
require_once "$ui_path/ManagerScripts.php";
require_once "$ui_path/ManagerHealthScripts.php";
require_once "$ui_path/NchanSubscribers.php";
?>

<!-- T-08 (ACTIVITY_TRAY.md): activity tray web component — self-mounts to body -->
<script src="/plugins/unraid-aicliagents/assets/ui/activity-tray.js?v=<?= htmlspecialchars($tray_ver) ?>"></script>
<!-- AGENT_VOICE.md R4/R7/R8: agent voice — subscribes aicli_voice, owns the per-device toggle -->
<script src="/plugins/unraid-aicliagents/assets/ui/voice.js?v=<?= htmlspecialchars($voice_ver) ?>"></script>
